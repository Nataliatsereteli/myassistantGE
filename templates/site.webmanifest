{
  "name": {{ site.brand.name | tojson }},
  "short_name": {{ site.brand.name | tojson }},
  "description": {{ t.meta.tagline | tojson }},
  "lang": {{ lang | tojson }},
  "start_url": {{ (base ~ "/" ~ lang ~ "/") | tojson }},
  "scope": {{ (base ~ "/") | tojson }},
  "display": "standalone",
  "background_color": "#f7f3ea",
  "theme_color": "#7c1f2c",
  "icons": [
    { "src": {{ (base ~ "/assets/img/icon-192.png") | tojson }}, "sizes": "192x192", "type": "image/png" },
    { "src": {{ (base ~ "/assets/img/icon-512.png") | tojson }}, "sizes": "512x512", "type": "image/png" },
    { "src": {{ (base ~ "/assets/img/favicon.svg") | tojson }}, "sizes": "any", "type": "image/svg+xml" }
  ]
}
