# ============================================================================
#  Что НЕ попадает в репозиторий.
#
#  Важно понимать границу: .gitignore работает только когда файлы добавляют
#  через git. Правки через веб-интерфейс github.com он не фильтрует — там
#  файл, который вы загрузили руками, попадёт в репозиторий несмотря на
#  любые правила ниже. Поэтому главное правило простое:
#
#      НИКОГДА не загружайте через сайт GitHub сканы документов,
#      выписки, списки клиентов и вообще ничего с персональными данными.
#
#  Репозиторий публичный. Всё, что попало в git, остаётся в истории
#  даже после удаления файла.
# ============================================================================

# --- Результат сборки: генерируется, в репозитории не нужен ---------------
_site/

# --- Кэш скриптов (TTF-шрифты для генерации картинок) ---------------------
.cache/

# --- ПЕРСОНАЛЬНЫЕ ДАННЫЕ. Никогда не коммитить ---------------------------
private/

# Таблицы и документы: обычный формат клиентских списков и выписок
*.csv
*.tsv
*.xlsx
*.xls
*.docx
*.doc
*.pdf
*.rtf

# Архивы: в них чаще всего и приезжают чужие данные
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

# Сканы и фотографии документов в корне репозитория.
# Картинки самого сайта лежат в assets/img/ и под это правило не попадают.
/*.jpg
/*.jpeg
/*.png
/*.webp
/*.heic
/*.tif
/*.tiff

# --- Секреты --------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*

# --- Служебное ------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.claude/
*.stackdump

# --- Локальные файлы разработки: в репозиторий не входят -------------------
# Относятся к машине разработчика и к подготовке передачи проекта,
# для работы сайта не нужны.
scripts/make_handover.py
scripts/build_contacts.py

# --- Внутренняя документация ----------------------------------------------
# Репозиторий публичный, а в docs/ лежит внутренняя кухня: разбор
# конкурентов, SEO-стратегия, чеклист запуска с контактами, риски бренда.
# Инструкции передаются владелице отдельно, в архиве, а не через GitHub.
docs/
